---
import '../styles/site.css';
import { nav } from '../data/nav.js';

interface Props { title: string; description?: string; path: string; noindex?: boolean }
const { title, description = '', path, noindex = false } = Astro.props;

// path only picks the highlighted menu item; the page's own address comes from the URL.
const site = Astro.site ?? 'https://www.mutechlab.education';
const own = Astro.url.pathname.replace(/\/?$/, '/');
const canonical = new URL(own, site).href;
const ogImage = new URL('/images/og-mutechlab.jpg', site).href;
const siteData = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: 'MuTechLab',
  url: new URL('/', site).href,
  description: 'Music technology in the training of music teachers and music students, an initiative of the University of Luxembourg.',
  publisher: { '@type': 'CollegeOrUniversity', name: 'University of Luxembourg', url: 'https://www.uni.lu/' },
};

const isOn = (item) => item.href === path || (item.also ?? []).includes(path);
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    {description && <meta name="description" content={description} />}
    {noindex ? <meta name="robots" content="noindex" /> : <link rel="canonical" href={canonical} />}
    <link rel="icon" href="/favicon.png" type="image/png" />
    <link rel="apple-touch-icon" href="/favicon.png" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="MuTechLab" />
    <meta property="og:title" content={title} />
    {description && <meta property="og:description" content={description} />}
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="The MuTechLab logo: a ring of coloured sound waves" />
    <meta name="twitter:card" content="summary_large_image" />
    {Astro.url.pathname === '/' && <script type="application/ld+json" set:html={JSON.stringify(siteData).replace(/</g, '\\u003c')} />}
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,300..600;1,9..144,300..600&family=Manrope:wght@300..700&display=swap" rel="stylesheet" />
  </head>
  <body>
    <header class="top">
      <a href="/" class="logo-link"><img class="logo" src="/images/2b51b9b94f.jpg" alt="MuTechLab" width="72" height="72" /></a>
      <nav aria-label="Main">
        <ul class="menu">
          {nav.map((item) => <li><a href={item.href} class={isOn(item) ? 'on' : ''}>{item.label}</a></li>)}
        </ul>
      </nav>
    </header>
    <main><slot /></main>
    <footer>
      <img src="/images/a52603f399.jpg" alt="Université du Luxembourg" />
      <img src="/images/52f4dff6e0.png" alt="Faculty of Humanities, Education and Social Sciences" />
    </footer>
    <dialog class="lb" data-video-lb aria-label="Video player">
      <button class="lb-x" type="button" aria-label="Close" data-close>×</button>
      <button class="cf-nav prev" type="button" aria-label="Previous video" data-prev>
        <svg viewBox="0 0 20 40" aria-hidden="true"><path d="M18 2 2 20l16 18" /></svg>
      </button>
      <div class="lb-box">
        <div class="lb-frame" data-frame></div>
        <p class="lb-info" data-info></p>
      </div>
      <button class="cf-nav next" type="button" aria-label="Next video" data-next>
        <svg viewBox="0 0 20 40" aria-hidden="true"><path d="m2 2 16 18L2 38" /></svg>
      </button>
    </dialog>
    <script>
      // Videos open in a large player over the page, and only load from YouTube once someone presses play.
      const videos = [...document.querySelectorAll<HTMLButtonElement>('[data-yt]')];
      const lb = document.querySelector<HTMLDialogElement>('[data-video-lb]')!;
      const frame = lb.querySelector<HTMLElement>('[data-frame]')!;
      const info = lb.querySelector<HTMLElement>('[data-info]')!;
      let current = 0;

      function play(i: number) {
        current = (i + videos.length) % videos.length;
        const b = videos[current];
        const f = document.createElement('iframe');
        f.src = `https://www.youtube-nocookie.com/embed/${b.dataset.yt}?autoplay=1&rel=0&playsinline=1`;
        f.title = b.title;
        f.allow = 'autoplay; encrypted-media; picture-in-picture; fullscreen';
        f.allowFullscreen = true;
        frame.replaceChildren(f);
        info.textContent = b.title === 'Video' ? '' : b.title;
      }

      videos.forEach((b, i) => b.addEventListener('click', () => { play(i); lb.showModal(); }));
      // With one video on the page there is nothing to move to.
      lb.querySelectorAll<HTMLElement>('.cf-nav').forEach((n) => { n.hidden = videos.length < 2; });
      lb.querySelector('[data-prev]')!.addEventListener('click', () => play(current - 1));
      lb.querySelector('[data-next]')!.addEventListener('click', () => play(current + 1));
      lb.querySelector('[data-close]')!.addEventListener('click', () => lb.close());
      lb.addEventListener('click', (e) => { if (e.target === lb) lb.close(); });
      lb.addEventListener('keydown', (e) => {
        if (e.key === 'ArrowLeft') play(current - 1);
        if (e.key === 'ArrowRight') play(current + 1);
      });
      // Closing removes the player, which stops the video.
      lb.addEventListener('close', () => { frame.replaceChildren(); videos[current]?.focus(); });
    </script>
    <script is:inline>
      var sc_project = 13177695;
      var sc_invisible = 1;
      var sc_security = '6dbe20df';
    </script>
    <script is:inline async src="https://www.statcounter.com/counter/counter.js"></script>
  </body>
</html>
